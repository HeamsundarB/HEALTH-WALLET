# FastAPI Application Settings
PROJECT_NAME="HEALTH WALLET"
ENVIRONMENT="development"
DEBUG=True

# Security Settings Foundation (DO NOT USE REAL SECRETS IN PRODUCTION)
SECRET_KEY="your-super-secret-key-change-this-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM="HS256"

# Database Settings Foundation (PostgreSQL)
POSTGRES_USER="health_user"
POSTGRES_PASSWORD="health_pass"
POSTGRES_DB="health_wallet_db"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432

# SQLAlchemy Database Connection URL
DATABASE_URL="postgresql://health_user:health_pass@localhost:5432/health_wallet_db"

# Frontend Configuration
VITE_API_BASE_URL="http://localhost:8000"
